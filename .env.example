# ─── Supabase (required) ────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."     # secret, server-only

# Gate for POST /api/seed (any random string; used once after deploy)
SEED_SECRET="change-this"

# ─── Email notifications (Resend with verified roopnow.com domain) ─
# Without RESEND_API_KEY set, notifications log to console and skip
# sending — safe for local/preview without secrets.
#
# Setup:
#  1. Resend Dashboard → Domains → Add "roopnow.com" → add the SPF
#     TXT + 2 DKIM CNAME records they show, at your DNS provider.
#  2. Wait for the green "Verified" badge (usually <5 min).
#  3. Resend → API Keys → create a key with "Sending access" → paste.
RESEND_API_KEY=""
# Branded sender. Domain MUST be verified in Resend or sends will 403.
MAIL_FROM="Roop <hello@roopnow.com>"
# Where user replies land. Should be a real, watched inbox.
MAIL_REPLY_TO="surakshawork20@gmail.com"

# Used inside email CTAs as the base of all links.
NEXT_PUBLIC_SITE_URL="https://roopnow.com"

# ─── Payments (optional — Razorpay) ─────────────────────────────
# Without these, the Payments tab shows "Payments not configured on server"
# when artists try to pay. Frontend still renders.
# Dashboard → Settings → API Keys (use live keys for prod, test keys for dev)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
