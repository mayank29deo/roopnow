# ─── Supabase (required) ────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."     # secret, server-only

# Gate for POST /api/seed (any random string; used once after deploy)
SEED_SECRET="change-this"

# ─── Email notifications (Gmail SMTP via nodemailer) ─────────────
# Without these, notifications log to console and skip sending.
#
# Setup:
#  1. Enable 2-Step Verification on the Gmail account.
#  2. Google Account → Security → 2-Step Verification → App passwords
#     → Generate a new app password for "Mail / Other (Roop server)".
#  3. Paste the 16-character password (no spaces) below.
GMAIL_USER="surakshawork20@gmail.com"
GMAIL_APP_PASSWORD=""
# Optional: tweak the display name shown to recipients.
MAIL_FROM_NAME="Roop"

# Used inside email CTAs as the base of all links.
NEXT_PUBLIC_SITE_URL="https://roopnow.com"

# ─── Payments (optional — Razorpay) ─────────────────────────────
# Without these, the Payments tab shows "Payments not configured on server"
# when artists try to pay. Frontend still renders.
# Dashboard → Settings → API Keys (use live keys for prod, test keys for dev)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
